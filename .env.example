# ============================================================
# Filter — PromptShield + Bifrost — Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- General ---
COMPOSE_PROJECT_NAME=filter-bifrost

# --- Nginx ---
NGINX_HOST=your-domain.com
# Or leave empty and use IP:port directly

# --- Postgres (PromptShield dashboard) ---
POSTGRES_PASSWORD=change-me-to-a-strong-password

# --- PromptShield Gateway ---
PROMPTSHIELD_PORT=8080
PROMPTSHIELD_ADMIN_TOKEN=change-me-gateway-admin-token
# Provider: openai-compatible mode — Bifrost acts as upstream
PROMPTSHIELD_PROVIDER=openai-compatible
PROMPTSHIELD_OPENAI_COMPATIBLE_UPSTREAM_URL=http://bifrost:8081/v1
PROMPTSHIELD_OPENAI_COMPATIBLE_MODEL=
# Multi-provider routes (comma-separated: model=provider)
PROMPTSHIELD_MODEL_ROUTES=

# --- PromptShield Engine (PII Detection) ---
PROMPTSHIELD_ENGINE_URL=http://promptshield-engine:4321
PROMPTSHIELD_ENGINE_API_KEY=change-me-engine-api-key
PROMPTSHIELD_ENGINE_PORT=4321
PROMPTSHIELD_ENGINE_HOST=0.0.0.0
PROMPTSHIELD_LOG_LEVEL=INFO
# spaCy language profile: minimal | fr | de | ja | multi
SPACY_PROFILE=minimal

# --- PromptShield Policy ---
PROMPTSHIELD_POLICY_PATH=/policy/policy.yaml
PROMPTSHIELD_ALLOW_DEFAULT_POLICY=false

# --- PromptShield Dashboard ---
BETTER_AUTH_SECRET=change-me-better-auth-secret-min-32-chars
ENGINE_URL=http://promptshield-engine:4321
ENGINE_API_KEY=change-me-engine-api-key
GATEWAY_URL=http://promptshield-gateway:8080
AUDIT_INGEST_SECRET=change-me-audit-ingest-secret
CONFIG_ADMIN_EMAILS=admin@yourcompany.com

# --- Bifrost ---
BIFROST_PORT=8081
BIFROST_LOG_LEVEL=info
# Bifrost API keys are configured via Web UI after startup

# --- LLM Provider API Keys ---
# These are passed to Bifrost (configured via its Web UI)
# PromptShield gateway doesn't need them — it forwards to Bifrost
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
