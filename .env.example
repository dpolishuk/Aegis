# ============================================================
# Filter — PromptShield + Bifrost Configuration
# Copy this file to .env and fill in deployment values.
# Do not commit .env, provider API keys, or Bifrost runtime data.
# ============================================================

# --- Product / Nginx ---
COMPOSE_PROJECT_NAME=filter-bifrost
NGINX_HOST=your-domain.com
CORS_ORIGIN=https://your-domain.com
VITE_SERVER_URL=https://your-domain.com

# --- Postgres (PromptShield dashboard) ---
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ============================================================
# PromptShield inline security
# PromptShield screens /v1/* before any Bifrost/provider routing.
# It does not own provider API keys in this combined product.
# ============================================================

# --- PromptShield Gateway security proxy ---
PROMPTSHIELD_PORT=8080
PROMPTSHIELD_ADMIN_TOKEN=change-me-gateway-admin-token

# Bifrost is the only OpenAI-compatible upstream for allowed requests.
PROMPTSHIELD_PROVIDER=openai-compatible
PROMPTSHIELD_OPENAI_COMPATIBLE_UPSTREAM_URL=http://bifrost:8081/v1
PROMPTSHIELD_MODEL_ROUTES=

# --- PromptShield Engine (PII Detection) ---
PROMPTSHIELD_ENGINE_URL=http://promptshield-engine:4321
PROMPTSHIELD_ENGINE_API_KEY=change-me-engine-api-key
PROMPTSHIELD_ENGINE_PORT=4321
PROMPTSHIELD_ENGINE_HOST=0.0.0.0
PROMPTSHIELD_LOG_LEVEL=INFO
# spaCy language profile: minimal | fr | de | ja | multi
SPACY_PROFILE=minimal

# --- PromptShield Policy ---
PROMPTSHIELD_POLICY_PATH=/policy/policy.yaml
PROMPTSHIELD_ALLOW_DEFAULT_POLICY=false

# --- Dashboard, policy, and audit ---
BETTER_AUTH_SECRET=change-me-better-auth-secret-min-32-chars
ENGINE_URL=http://promptshield-engine:4321
ENGINE_API_KEY=change-me-engine-api-key
GATEWAY_URL=http://promptshield-gateway:8080
BIFROST_URL=http://bifrost:8081
AUDIT_INGEST_SECRET=change-me-audit-ingest-secret
CONFIG_ADMIN_EMAILS=admin@yourcompany.com
BETTER_AUTH_URL=https://your-domain.com

# ============================================================
# Bifrost provider/router control plane
# Provider secrets and model routing belong to Bifrost, not
# PromptShield. Add provider keys through Bifrost admin UI or
# an approved secret-management workflow. Never commit real keys.
# ============================================================

BIFROST_LOG_LEVEL=info

# Bifrost listens on the Docker network at http://bifrost:8081.
# Public inference clients must use https://your-domain.com/v1/*.
# /bifrost/ is local/admin UI access only, not public inference.
#
# Tracked bifrost-data/* files are runtime state and may contain provider keys,
# tokens, sessions, or logs. Do not commit new runtime DB/config snapshots.
